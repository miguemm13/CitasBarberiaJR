PUERTO=3000
NODE_ENV=development

# Base de datos: sqlite (por defecto, sin instalar nada) o postgres
DB_DIALECTO=sqlite
DB_ALMACENAMIENTO=./barberia_citas.sqlite

# Solo se usan si DB_DIALECTO=postgres
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=barberia_citas
DB_USUARIO=postgres
DB_CLAVE=postgres

# Bot de Telegram (ver README para el paso a paso de creación)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_BARBERIA=

# Dominio del frontend en producción, para restringir CORS (opcional).
# Ej: https://barberia-citas-frontend.onrender.com
# Si se deja vacío, se acepta cualquier origen.
CORS_ORIGEN=
